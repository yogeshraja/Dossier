{
  "name": "dossier-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 Backend for Dossier (Kiosk Vault & Touch POS)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:init:local": "wrangler d1 execute dossier-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute dossier-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.3",
    "wrangler": "^4.147.0"
  }
}
